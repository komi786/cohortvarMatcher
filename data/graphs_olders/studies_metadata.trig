        rdfs:label "intervention specification"^^xsd:string ;
        cmeo:has_value "oral semaglutide 3 mg, 7 mg, 14 mg"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/mixed_sex> a obi:mixed_sex ;
        rdfs:label "mixed sex"^^xsd:string ;
        cmeo:has_value "male=50.8%, female=49.2%"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/need_for_surgery_exclusion_criterion> a <https://w3id.org/CMEO//need_for_surgery_exclusion_criterion> ;
