    <https://w3id.org/CMEO/biostat-chf/age_group_inclusion_criterion/minimum_age_value_specification> a obi:minimum_age_value_specification ;
        cmeo:has_value "18.0"^^xsd:float .

    <https://w3id.org/CMEO/biostat-chf/clinically_relevant_exposure_exclusion_criterion> a <https://w3id.org/CMEO//clinically_relevant_exposure_exclusion_criterion> ;
        rdfs:label "clinically_relevant_exposure_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/biostat-chf/exclusion_criterion> ;
        cmeo:has_value "current known inability to follow instructions or comply with follow-up procedures"^^xsd:string,
            "heart transplant recipient or admitted for cardiac transplantation or left ventricular assist device surgery"^^xsd:string,
            "known diagnosis of acute myocarditis or hypertrophic obstructive, restrictive, or constrictive cardiomyopathy"^^xsd:string,
            "known diagnosis of septicaemia"^^xsd:string,
            "patients with concomitant pulmonary disease, even if severe, valvular disease, acute coronary syndrome or stroke, could be included when the primary diagnosis for admission to hospital or outpatient clinic visit was heart failure, rather than the concomitant condition."^^xsd:string,
            "treatment with medications or devices not approved in europe"^^xsd:string .

    <https://w3id.org/CMEO/biostat-chf/clinically_relevant_exposure_inclusion_criterion> a cmeo:clinically_relevant_exposure_inclusion_criterion ;
        rdfs:label "clinically relevant exposure inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/biostat-chf/inclusion_criterion> ;
        cmeo:has_value "a previous documented admission with heart failure requiring diuretic treatment"^^xsd:string,
            "be treated with furosemide ≥20 mg/day or equivalent"^^xsd:string .

