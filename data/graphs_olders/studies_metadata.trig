        ro:role_of <https://w3id.org/CMEO/gissi-hf/enrico_nicolis> ;
        cmeo:has_value "Enrico Nicolis"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/age_distribution> a obi:age_distribution ;
        rdfs:label "age distribution"^^xsd:string ;
        cmeo:has_value "67 ± 11 "^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/age_group_inclusion_criterion> a cmeo:age_group_inclusion_criterion ;
        rdfs:label "age group inclusion criterion"^^xsd:string ;
        ro:has_part <https://w3id.org/CMEO/gissi-hf/age_group_inclusion_criterion/maximum_age_value_specification>,
            <https://w3id.org/CMEO/gissi-hf/age_group_inclusion_criterion/minimum_age_value_specification> ;
        ro:part_of <https://w3id.org/CMEO/gissi-hf/inclusion_criterion> ;
        cmeo:has_value "<= 78 and >= 56 years old"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/age_group_inclusion_criterion/maximum_age_value_specification> a obi:maximum_age_value_specification ;
        cmeo:has_value "78.0"^^xsd:float .

    <https://w3id.org/CMEO/gissi-hf/age_group_inclusion_criterion/minimum_age_value_specification> a obi:minimum_age_value_specification ;
        cmeo:has_value "56.0"^^xsd:float .

    <https://w3id.org/CMEO/gissi-hf/clinically_relevant_exposure_inclusion_criterion> a cmeo:clinically_relevant_exposure_inclusion_criterion ;
