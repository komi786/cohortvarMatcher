    <https://w3id.org/CMEO/interval/objective_specification> a obi:objective_specification ;
        cmeo:has_value "main objective: blood donors are randomly assigned to different inter-donation intervals (men: 12 vs 10 vs 8 weeks; women: 16 vs 14 vs 12 weeks) to assess whether inter-donation intervals can be decreased to optimize blood supply while still maintaining the physical and mental health of the donors; sub-objective: examine whether inter-donation intervals can be adjusted based on each donor’s ability to give blood safely."^^xsd:string .

    <https://w3id.org/CMEO/interval/outcome_specification> a cmeo:outcome_specification ;
        rdfs:label "outcome specification"^^xsd:string ;
        ro:has_part <https://w3id.org/CMEO/interval/primary_outcome_specification> .

    <https://w3id.org/CMEO/interval/primary_outcome_specification> a cmeo:primary_outcome_specification ;
        rdfs:label "primary outcome specification"^^xsd:string ;
        cmeo:has_value "donor quality of life (according to short form health survey); number of deferrals caused by low haemoglobin (and other factors); measurements of iron status; test of cognitive function; measurement of physical activity; donor attitude via questionnaire; cost effectiveness (economic analysis of different strategies for blood supply to the nhs)"^^xsd:string .

