        ro:role_of <https://w3id.org/CMEO/pioneer/alix_feldman%3B_jonas_cerovsky> ;
        cmeo:has_value "Alix Feldman; Jonas Cerovsky"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/study_design_execution/end_time> a cmeo:end_time ;
        cmeo:has_value "1970-01-01T00:00:00"^^xsd:dateTime .

    <https://w3id.org/CMEO/pioneer/study_design_execution/start_time> a cmeo:start_time ;
