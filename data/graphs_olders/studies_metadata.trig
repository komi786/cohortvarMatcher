    <https://w3id.org/CMEO/gissi-hf/intervention> a cmeo:intervention_specification ;
        rdfs:label "intervention specification"^^xsd:string ;
        cmeo:has_value "n-3 polyunsaturated fatty acids (PUFA);Rosuvastatin"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/mixed_sex> a obi:mixed_sex ;
        rdfs:label "mixed sex"^^xsd:string ;
        cmeo:has_value "male=78.3%; female=21.7%"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/number_of_participants> a cmeo:number_of_participants ;
        rdfs:label "number of participants"^^xsd:string ;
        ro:is_part_of <https://w3id.org/CMEO/gissi-hf/randomized_controlled_trial/protocol> ;
        cmeo:has_value "6.975"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/objective_specification> a obi:objective_specification ;
        cmeo:has_value "to investigate whether long-term administration of n-3 pufa and rosuvastatin is more effective than the corresponding placebo in reducing all-cause mortality and all-cause mortality or hospitalizations for cardiovascular reasons"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/outcome_specification> a cmeo:outcome_specification ;
        rdfs:label "outcome specification"^^xsd:string ;
        ro:has_part <https://w3id.org/CMEO/gissi-hf/primary_outcome_specification>,
            <https://w3id.org/CMEO/gissi-hf/secondary_outcome_specification> .

    <https://w3id.org/CMEO/gissi-hf/primary_outcome_specification> a cmeo:primary_outcome_specification ;
        rdfs:label "primary outcome specification"^^xsd:string ;
        cmeo:has_value "time to death; time to death or admission to hospital for cardiovascular reasons"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/secondary_outcome_specification> a cmeo:secondary_outcome_specification ;
        rdfs:label "secondary outcome specification"^^xsd:string ;
        cmeo:has_value "cardiovascular mortality;cardiovascular mortality or admission for any reason;sudden cardiac death;admission for any reason;admission for cardiovascular reasons;admission for heart failure;myocardial infarction;stroke"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/sex_inclusion_criterion> a cmeo:sex_inclusion_criterion ;
        rdfs:label "sex inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/gissi-hf/inclusion_criterion> ;
        cmeo:has_value "male and female"^^xsd:string .

    <https://w3id.org/CMEO/gissi-hf/study_contact_person_role> a cmeo:study_contact_person_role ;
        ro:role_of <https://w3id.org/CMEO/gissi-hf/enrico_nicolis%3B_martina_colombo> ;
        cmeo:has_value "Enrico Nicolis; Martina Colombo"^^xsd:string .

