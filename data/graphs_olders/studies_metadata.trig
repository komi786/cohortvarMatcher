        rdfs:label "primary outcome specification"^^xsd:string ;
        cmeo:has_value "combined endpoint :18 months survival freeo fall-cause hospitalizations (all-cause death except cancer and hospitalization)"^^xsd:string .

    <https://w3id.org/CMEO/time-chf/secondary_outcome_specification> a cmeo:secondary_outcome_specification ;
        rdfs:label "secondary outcome specification"^^xsd:string ;
        cmeo:has_value """quality of life (qol) at 18 months on therapy; long-term mortality and morbidity (beyond 18 months);different domains of qol such as general health, daily activities, degree of mental
distress;patients’ end-of-life preferences;tolerability of therapy/risk factors of intolerability independence/disability after 18 months"""^^xsd:string .

