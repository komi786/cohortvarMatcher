        ro:has_output <https://w3id.org/CMEO/gluco-insight/output_population> .

    <https://w3id.org/CMEO/gluco-insight/input_population> a obi:population .

    <https://w3id.org/CMEO/gluco-insight/intervention> a cmeo:intervention_specification ;
        rdfs:label "intervention specification"^^xsd:string ;
        cmeo:has_value "Baseline lifestyle without any interventio; hourly physical 5 min activity (between 9-16h); 15 min walk after breakfast, lunch & dinner;low carb diet (low sugar & starch);mediterranean diet (high fruits, vegetables, nuts, fish, whole grain & olive oil)"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/mixed_sex> a obi:mixed_sex ;
        rdfs:label "mixed sex"^^xsd:string ;
        cmeo:has_value "male=53.7%; female=46.3%"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/need_for_surgery_exclusion_criterion> a <https://w3id.org/CMEO//need_for_surgery_exclusion_criterion> ;
        rdfs:label "need_for_surgery_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/gluco-insight/exclusion_criterion> ;
        cmeo:has_value "planned (bariatric) surgery in the upcoming 6 months ·"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/number_of_participants> a cmeo:number_of_participants ;
        rdfs:label "number of participants"^^xsd:string ;
        ro:is_part_of <https://w3id.org/CMEO/gluco-insight/single_arm_cross_over_design/protocol> ;
        cmeo:has_value "41"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/objective_specification> a obi:objective_specification ;
        cmeo:has_value "to gain a better understanding of the relation between blood glucose levels and patterns, and contextual data in individuals with t2d. an enhanced understanding of this relation can provide insights on how individuals with t2d can modify their lifestyle to improve glycaemic control. additionally, it is aimed to assess how different lifestyle interventions that are proven effective on a population level (mediterranean diet, low-carb diet, pa) affect glucose fluctuations and specific cgm parameters for individuals. to make sense of the generated data, a combination of traditional and novel analysis/ modelling techniques will be used."^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/outcome_specification> a cmeo:outcome_specification ;
        rdfs:label "outcome specification"^^xsd:string ;
        ro:has_part <https://w3id.org/CMEO/gluco-insight/primary_outcome_specification>,
            <https://w3id.org/CMEO/gluco-insight/secondary_outcome_specification> .

    <https://w3id.org/CMEO/gluco-insight/primary_outcome_specification> a cmeo:primary_outcome_specification ;
        rdfs:label "primary outcome specification"^^xsd:string ;
        cmeo:has_value "the main outcome of this study will be the understanding and prediction of glucose levels using real life contextual data (e.g. food intake, pa, stress and sleep) as well as lifestyle interventions. the main study parameter in this study consists of continuous measured glucose values (mmol/l) measured with the use of the dexcom g6."^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/secondary_outcome_specification> a cmeo:secondary_outcome_specification ;
        rdfs:label "secondary outcome specification"^^xsd:string ;
        cmeo:has_value "an enhanced understanding of the relation of glucose levels and contextual data should provide insights on how to modify an unhealthy lifestyle via data driven digital behavioural coaching programs. additionally, the different lifestyle interventions may be used to assess how these affect specific cgm parameters."^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/sex_inclusion_criterion> a cmeo:sex_inclusion_criterion ;
        rdfs:label "sex inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/gluco-insight/inclusion_criterion> ;
        cmeo:has_value "male and female"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/study_contact_person_role> a cmeo:study_contact_person_role ;
        ro:role_of <https://w3id.org/CMEO/gluco-insight/willem_van_den_brink> ;
        cmeo:has_value "Willem van den Brink"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/study_design_execution/end_time> a cmeo:end_time ;
        cmeo:has_value "2022-07-01T00:00:00"^^xsd:dateTime .

