    <https://w3id.org/CMEO/gluco-insight/descriptor> a sio:descriptor ;
        rdfs:label "early risk"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/health__status_exclusion_criterion> a <https://w3id.org/CMEO//health__status_exclusion_criterion> ;
        rdfs:label "health__status_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/gluco-insight/exclusion_criterion> ;
        cmeo:has_value "4 or more alcoholic drinks per day on a regular basis or use of recreational drugs"^^xsd:string,
            "a condition that would need an mri in the upcoming 6 months"^^xsd:string,
            "active cancer or chemotherapy or radiation within 2 years prior to participation"^^xsd:string,
            "chronic anaemia (haemoglobin of 6.2 mmol/l or less)"^^xsd:string,
            "chronic medical condition, treatment, or medication other than diabetes that may affect glucose metabolism (hiv diagnosis, use of steroids or immunosuppressive drugs, etc.)"^^xsd:string,
            "coeliac or crohns’ disease"^^xsd:string,
            "food allergies or intolerances including, gluten, wheat, egg, (pea)nuts, celery, sesame, soy, cacao, glutamate, legumes, coriander, maize, (shell)fish, chicken, beef, pork, lamb, sulphites, lupine, milk and lactose"^^xsd:string,
            "history of bariatric weight loss surgery"^^xsd:string,
            "planned (bariatric) surgery in the upcoming 6 months"^^xsd:string,
            "pregnancy or a pregnancy wish"^^xsd:string,
            "skin allergy, eczema or known sensitivity for plasters"^^xsd:string,
            "use of antibiotics or fertility treatments within 3 months prior to participation"^^xsd:string .

    <https://w3id.org/CMEO/gluco-insight/health_status_inclusion_criterion> a cmeo:health_status_inclusion_criterion ;
