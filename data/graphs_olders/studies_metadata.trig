    <https://w3id.org/CMEO/pioneer/clinically_relevant_exposure_exclusion_criterion> a <https://w3id.org/CMEO//clinically_relevant_exposure_exclusion_criterion> ;
        rdfs:label "clinically_relevant_exposure_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/pioneer/exclusion_criterion> ;
        cmeo:has_value "treatment with any medication for the indication of diabetes or obesity in a period of 90 days before the day of screening. an exception is short-term insulin treatment for acute illness for a total of below or equal to 14 days"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/clinically_relevant_exposure_inclusion_criterion> a cmeo:clinically_relevant_exposure_inclusion_criterion ;
        rdfs:label "clinically relevant exposure inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/pioneer/inclusion_criterion> ;
        cmeo:has_value "treatment with diet and exercise for at least 30 days prior to day of screening"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/comparator> a cmeo:comparator_specification ;
        rdfs:label "comparators specification"^^xsd:string ;
        cmeo:has_value "Placebo"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/data_format_specification> a obi:data_format_specification ;
        rdfs:label "data format specification"^^xsd:string ;
        cmeo:has_value ""^^xsd:string .

    <https://w3id.org/CMEO/pioneer/descriptor> a sio:descriptor ;
        rdfs:label "early risk"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/health__status_exclusion_criterion> a <https://w3id.org/CMEO//health__status_exclusion_criterion> ;
        rdfs:label "health__status_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/pioneer/exclusion_criterion> ;
        cmeo:has_value "any disorder, which in the investigator's opinion might jeopardise subject's safety or compliance with the protocol"^^xsd:string,
            "family or personal history of multiple endocrine neoplasia type 2 or medullary thyroid carcinomas"^^xsd:string,
            "female who is pregnant, breast-feeding or intends to become pregnant"^^xsd:string,
            "history of pancreatitis (acute or chronic)"^^xsd:string,
            "history or presence of malignant neoplasms within the last 5 years (except basal and squamous cell skin cancer and in-situ carcinomas)"^^xsd:string,
            "myocardial infarction, stroke or hospitalisation for unstable angina or transient ischaemic attack within the past 180 days prior to the day of screening and randomisation"^^xsd:string,
            "proliferative retinopathy or maculopathy requiring acute treatment"^^xsd:string,
            "renal impairment defined as estimated glomerular filtration rate below 60 ml/min/1.73 m^2 as per chronic kidney disease epidemiology collaboration formula"^^xsd:string,
            "subjects presently classified as being in new york heart association class iv"^^xsd:string,
            "subjects with alanine aminotransferase above 2.5 x upper normal limit"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/health_status_inclusion_criterion> a cmeo:health_status_inclusion_criterion ;
        rdfs:label "health status inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/pioneer/inclusion_criterion> ;
        cmeo:has_value "type 2 diabetes mellitus hba1c (glycosylated haemoglobin) between 7.0-9.5% (53-80 mmol/mol) (both inclusive)"^^xsd:string .

