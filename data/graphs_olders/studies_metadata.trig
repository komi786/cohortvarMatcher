        rdfs:label "data format specification"^^xsd:string ;
        cmeo:has_value "excel, csv and json"^^xsd:string .

    <https://w3id.org/CMEO/dp5/descriptor> a sio:descriptor ;
        rdfs:label "digital biomarkers for personalized nutrition: predicting meal moments and interstitial glucose with non-invasive, wearable technologies"^^xsd:string .

    <https://w3id.org/CMEO/dp5/health__status_exclusion_criterion> a <https://w3id.org/CMEO//health__status_exclusion_criterion> ;
        rdfs:label "health__status_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/dp5/exclusion_criterion> ;
        cmeo:has_value "bmi > 25"^^xsd:string,
            "coeliac disease or gluten intolerance"^^xsd:string,
            "diabetes mellitus type 2 patients, and/or people with a finger-prick glucose value ≥ 7.8 mmol/l during screening"^^xsd:string,
            "performs intensive sport activities more than 6 hours per week"^^xsd:string,
            "pregnant or lactating women"^^xsd:string,
            "skin allergy, eczema or known sensitivity for plasters"^^xsd:string,
            "specific dietary preferences, including vegan, raw food, paleo. vegetarian, pescatarians and flexitarians can participate in the study"^^xsd:string,
            "under treatment for neurological or psychiatric complaints, including eating disorders"^^xsd:string .

    <https://w3id.org/CMEO/dp5/human_subject_enrollment> a cmeo:human_subject_enrollment ;
        ro:has_input <https://w3id.org/CMEO/dp5/input_population> ;
