    <https://w3id.org/CMEO/devote/clinically_relevant_exposure_exclusion_criterion> a <https://w3id.org/CMEO//clinically_relevant_exposure_exclusion_criterion> ;
        rdfs:label "clinically_relevant_exposure_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/devote/exclusion_criterion> ;
        cmeo:has_value "current hemodialysis or peritoneal dialysis"^^xsd:string,
            """known or suspected hypersensitivity to trial products
or related products"""^^xsd:string,
            """receipt of any investigational medicinal product
within 30 d before randomization"""^^xsd:string .

    <https://w3id.org/CMEO/devote/data_format_specification> a obi:data_format_specification ;
        rdfs:label "data format specification"^^xsd:string ;
        cmeo:has_value "cdisc"^^xsd:string .

    <https://w3id.org/CMEO/devote/health__status_exclusion_criterion> a <https://w3id.org/CMEO//health__status_exclusion_criterion> ;
        rdfs:label "health__status_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/devote/exclusion_criterion> ;
        cmeo:has_value "an acute coronary or cerebrovascular event in the previous 60 d"^^xsd:string,
            "chronic heart failure nyha class iv"^^xsd:string,
            """current or past (within the last 5 y) malignant neoplasms (except
basal cell and squamous cell skin carcinoma), female who is pregnant, breast-feeding or intends to become pregnant"""^^xsd:string,
            "egfr b30 ml/min per 1.73 m2 per ckd-epi"^^xsd:string,
            """end-stage liver disease, defined as the presence
of acute or chronic liver disease and recent history
of 1 or more of the following: ascites, encephalopathy,
variceal bleeding, bilirubin ≥2.0 mg/dl,
albumin level ≤3.5 g/dl, prothrombin time ≥4 s
prolonged, international normalized ratio ≥1.7"""^^xsd:string .

    <https://w3id.org/CMEO/devote/health_status_inclusion_criterion> a cmeo:health_status_inclusion_criterion ;
        rdfs:label "health status inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/devote/inclusion_criterion> ;
        cmeo:has_value "age ≥50 y at screening"^^xsd:string,
            "ankle/brachial index b0.9"^^xsd:string,
            "asymptomatic cardiac ischemia documented by positive nuclear imaging test or exercise test or dobutamine stress echocardiogram"^^xsd:string,
            "chronic heart failure nyha class ii-iii"^^xsd:string,
            "chronic kidney disease corresponding to glomerular filtration rate 30-59 ml/min per 1.73m2 per ckd-epi"^^xsd:string,
            "hba1c ≥7.0% or hba1c b7.0%"^^xsd:string,
            "history of symptomatic coronary heart disease documented by positive exercise stress test or any cardiac imaging, or unstable angina pectoris with ecg changes"^^xsd:string,
            "hypertension and left ventricular hypertrophy by ecg or imaging"^^xsd:string,
            "left ventricular systolic and diastolic dysfunction by imaging"^^xsd:string,
            "microalbuminuria or proteinuria"^^xsd:string,
            "prior coronary, carotid, or peripheral arterial revascularization"^^xsd:string,
            "prior myocardial infarction prior stroke or prior tia"^^xsd:string,
            "type 2 diabetes mellitus"^^xsd:string .

