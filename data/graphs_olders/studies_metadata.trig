    <https://w3id.org/CMEO/time-chf/objective_specification> a obi:objective_specification ;
        cmeo:has_value "comparative study with an intensified treatment strategy guided by nt-bnp levels against standard symptom-guided therapy in  chronic heart failure patients patients aged 60-74 years and those 75 years or older"^^xsd:string .

