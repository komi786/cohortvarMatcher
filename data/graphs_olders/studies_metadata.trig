    <https://w3id.org/CMEO/time-chf/clinically_relevant_exposure_inclusion_criterion> a cmeo:clinically_relevant_exposure_inclusion_criterion ;
        rdfs:label "clinically relevant exposure inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/time-chf/inclusion_criterion> ;
        cmeo:has_value "a history of  congestive heart failure hospitalization within the last year"^^xsd:string,
            "an nt-bnp level higher than twice the upper limit of normal. specifically, this meant ≥400 pg/ml for patients aged 60 to 74 years and ≥800 pg/ml for patients aged ≥75 years"^^xsd:string .

