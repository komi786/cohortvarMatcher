        rdfs:label "study design variable specification"^^xsd:string ;
        dc:format <https://w3id.org/CMEO/pioneer/data_format_specification> .

    <https://w3id.org/CMEO/pioneer/surgical_procedure_history_exclusion_criterion> a <https://w3id.org/CMEO//surgical_procedure_history_exclusion_criterion> ;
        rdfs:label "surgical_procedure_history_exclusion_criterion"^^xsd:string ;
