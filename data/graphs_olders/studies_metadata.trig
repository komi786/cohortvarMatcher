    <https://w3id.org/CMEO/devote/timeline_specification> a cmeo:timeline_specification ;
        cmeo:has_value """After randomization, patients were seen weekly for 2
weeks, monthly for 6 months, and then every 3 months
for the remaining part of the trial. There was a planned
end-of-treatment follow-up visit 30 days after investigational product discontinuation."""^^xsd:string .

