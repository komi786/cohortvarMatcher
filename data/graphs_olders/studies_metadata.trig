        cmeo:has_value "clinical evidence of cardiovascular disease or subclinical evidence of cardiovascular disease"^^xsd:string,
            "hba1c above or equal to 7.0% at screening"^^xsd:string,
            "type 2 diabetes mellitus"^^xsd:string .

