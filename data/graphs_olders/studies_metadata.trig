    <https://w3id.org/CMEO/cycle/objective_specification> a obi:objective_specification ;
        cmeo:has_value """prospective, controlled, randomized, multicentre trial to examine whether
a single intravenous bolus of cyclosporine a before pci can reduce myocardial
reperfusion injury in patients with stemi."""^^xsd:string .

    <https://w3id.org/CMEO/cycle/outcome_specification> a cmeo:outcome_specification ;
        rdfs:label "outcome specification"^^xsd:string ;
        ro:has_part <https://w3id.org/CMEO/cycle/primary_outcome_specification>,
