        ro:is_part_of <https://w3id.org/CMEO/pioneer/randomized_controlled_trial/protocol> ;
        cmeo:has_value "703"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/objective_specification> a obi:objective_specification ;
        cmeo:has_value "this trial compared the efficacy and safety of the first oral glucagon-like peptide 1 (glp-1) receptor agonist, oral semaglutide, as monotherapy with placebo in patients with type 2 diabetes managed by diet and exercise alone."^^xsd:string .

    <https://w3id.org/CMEO/pioneer/outcome_specification> a cmeo:outcome_specification ;
        rdfs:label "outcome specification"^^xsd:string ;
        ro:has_part <https://w3id.org/CMEO/pioneer/primary_outcome_specification>,
            <https://w3id.org/CMEO/pioneer/secondary_outcome_specification> .

    <https://w3id.org/CMEO/pioneer/primary_outcome_specification> a cmeo:primary_outcome_specification ;
        rdfs:label "primary outcome specification"^^xsd:string ;
        cmeo:has_value "change from baseline (week 0) to week 26 in glycosylated haemoglobin (hba1c). the endpoint was evaluated based on data from the in-trial observation period. the in-trial observation period - time period from when a subject was randomised until the final scheduled visit, including any period after initiation of rescue medication or premature discontinuation of trial product. the primary endpoint was also analysed based on data from the on-treatment without rescue medication observation period. the on-treatment without rescue medication observation period - time period when a subject was on treatment with trial product, excluding any period after initiation of rescue medication."^^xsd:string .

    <https://w3id.org/CMEO/pioneer/secondary_outcome_specification> a cmeo:secondary_outcome_specification ;
        rdfs:label "secondary outcome specification"^^xsd:string ;
        cmeo:has_value "change in body weight (kg); change in fasting plasma glucose; change in mean 7-point smpg profile; change in mean postprandial increment over all meals in smpg; change in fasting insulin - ratio to baseline; change in fasting pro-insulin - ratio to baseline; change in fasting glucagon - ratio to baseline; change in homa-ir (insulin resistance) - ratio to baseline; change in homa-b (beta-cell function) - ratio to baseline; change in crp - ratio to baseline; change in body weight (%); change in bmi; change in waist circumference; change in fasting total cholesterol - ratio to baseline ; change in fasting ldl cholesterol - ratio to baseline; change in fasting hdl cholesterol - ratio to baseline; change in fasting triglycerides - ratio to baseline; participants who achieve hba1c < 7.0 % (53 mmol/mol) ada target (yes/no); participants who achieve hba1c ≤ 6.5 % (48 mmol/mol) aace target (yes/no); participants who achieve body weight loss ≥ 5 % (yes/no); participants who achieve body weight loss ≥ 10 % (yes/no); participants who achieve hba1c < 7.0 % (53 mmol/mol) without hypoglycaemia (severe or bg-confirmed symptomatic hypoglycaemia) and without body weight gain (yes/no); participants who achieve hba1c reduction ≥ 1.0% (10.9 mmol/mol) and weight loss ≥ 3% (yes/no); time to additional anti-diabetic medication; time to rescue medication; number of treatment-emergent adverse events (teaes); change in amylase - ratio to baseline; change in lipase - ratio to baseline; change in pulse rate; change in systolic blood pressure (sbp); change in diastolic blood pressure (dbp); change in electrocardiogram (ecg) evaluation; change in physical examination; change in eye examination category; occurrence of anti-semaglutide binding antibodies (yes/no); occurrence of anti-semaglutide neutralising antibodies (yes/no); occurrence of anti-semaglutide binding antibodies cross reacting with native glp-1 (yes/no); occurrence of anti-semaglutide neutralising antibodies cross reacting with native glp-1 (yes/no); anti-semaglutide binding antibody levels; number of treatment-emergent severe or blood glucose-confirmed symptomatic hypoglycaemic episodes during exposure to trial product; participants with treatment-emergent severe or blood glucose-confirmed symptomatic hypoglycaemic episodes during exposure to trial product; snac plasma concentrations; semaglutide plasma concentrations for population pk analysis; change in sf-36v2 (acute version) health survey: scores from the 8 domains, the physical component summary (pcs) and the mental component summary (mcs); iwqol-lite clinical trial version: total score of the 22 items (used for validation of the questionnaire); pgi-s item: scores of the two individual items (used for validation of the iwqol questionnaire); pgi-c item: scores of the two individual items (used for validation of the iwqol questionnaire)"^^xsd:string .

    <https://w3id.org/CMEO/pioneer/sex_inclusion_criterion> a cmeo:sex_inclusion_criterion ;
        rdfs:label "sex inclusion criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/pioneer/inclusion_criterion> ;
        cmeo:has_value "male and female"^^xsd:string .

