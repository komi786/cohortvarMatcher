    <https://w3id.org/CMEO/sustain6/health__status_exclusion_criterion> a <https://w3id.org/CMEO//health__status_exclusion_criterion> ;
        rdfs:label "health__status_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/sustain6/exclusion_criterion> ;
        cmeo:has_value "acute coronary or cerebro-vascular event within 90 days prior to randomisation"^^xsd:string,
            "acute decompensation of glycaemic control requiring immediate intensification of treatment to prevent acute complications of diabetes (eg diabetes ketoacidosis) within 90 days prior to screening"^^xsd:string,
            "chronic heart failure new york heart association (nyha) class iv"^^xsd:string,
            "history of chronic pancreatitis or idiopathic acute pancreatitis"^^xsd:string,
            "personal history of non-familial medullary thyroid carcinoma"^^xsd:string,
            "personal or family history of multiple endocrine neoplasia type 2 (men2) or familial medullary thyroid carcinoma"^^xsd:string,
            "type 1 diabetes mellitus"^^xsd:string .

