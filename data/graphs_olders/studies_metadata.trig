    <https://w3id.org/CMEO/sustain6/clinically_relevant_exposure_exclusion_criterion> a <https://w3id.org/CMEO//clinically_relevant_exposure_exclusion_criterion> ;
        rdfs:label "clinically_relevant_exposure_exclusion_criterion"^^xsd:string ;
        ro:part_of <https://w3id.org/CMEO/sustain6/exclusion_criterion> ;
        cmeo:has_value "screening calcitonin above or equal to 50 ng/l"^^xsd:string,
            "treatment with insulin other than basal and pre-mixed insulin within 90 days prior to screening except for short-term use in connection with intercurrent illness"^^xsd:string,
            "use of any dipeptidyl peptidase 4 (dpp-iv) inhibitor within 30 days prior to screening"^^xsd:string,
            "use of glucagon-like peptide-1 (glp-1) receptor agonist (exenatide, liraglutide, or other) or pramlintide within 90 days prior to screening"^^xsd:string .

